# Get a key at https://serper.dev (2,500 free queries to start).
# Each organization looked up uses about one credit.
SERPER_API_KEY=

# A reachable contact address, advertised in the crawler's User-Agent.
# This is what makes the crawl defensible if a site owner wants to reach you.
CRAWLER_CONTACT_EMAIL=you@example.com

# Optional email finder. When the website shows no email, it finds the
# official's own address from their name and the website's domain; only
# verified addresses are used. Leave blank to run without one.
# Anymailfinder (https://anymailfinder.com): charges only for verified emails.
ANYMAILFINDER_API_KEY=
# Or Hunter.io (https://hunter.io), used only when no Anymailfinder key is set.
HUNTER_API_KEY=
